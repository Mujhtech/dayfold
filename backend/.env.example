# Local development only; export these in your shell (no automatic dotenv loading).
DATABASE_URL=postgres://dayfold:dayfold-local-only@127.0.0.1:55432/dayfold
DAYFOLD_BIND=127.0.0.1:8080
# Explicit test-only legacy tokens. Requires loopback bind and APNs disabled.
DAYFOLD_ALLOW_LEGACY_DEV_AUTH=true
# Public sessions require all four settings; never use legacy auth publicly.
# DAYFOLD_OIDC_ISSUER=https://identity.example.com
# DAYFOLD_OIDC_CLIENT_IDS=registered-native-client-id
# DAYFOLD_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# DAYFOLD_SESSION_KEY_FILE=/absolute/path/to/private-session-key
# Public HTTPS origin, without a path; change before registering real Google watches.
DAYFOLD_PUBLIC_ORIGIN=https://relay.example.com
# APNs is disabled unless all four credentials/configuration values are present.
# DAYFOLD_APNS_TEAM_ID=
# DAYFOLD_APNS_KEY_ID=
# DAYFOLD_APNS_TOPIC=mujhtech.dayfold
# DAYFOLD_APNS_KEY_FILE=/absolute/path/to/AuthKey.p8
